<?xml version="1.0" encoding="utf-8"?>
<!-- Une lecture = une ligne, et rien d'éditable : la liste sert à repérer la
     ligne à contrôler, la correction se fait sur l'écran de contrôle, photo à
     l'appui. Un champ ici invitait à corriger sans regarder la gravure. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/thumb"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@color/separateur"
        android:contentDescription="@string/thumb_desc"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/serial"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:textColor="@color/texte"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:textColor="@color/a_reprendre"
        android:textSize="12sp"
        android:visibility="gone" />

    <View
        android:id="@+id/status"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/pastille" />
</LinearLayout>
